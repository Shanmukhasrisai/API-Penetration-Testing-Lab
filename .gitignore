# ==============================================================================
# API Penetration Testing Lab - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Byte-Compiled / Python Execution Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
__pypackages__/
.pip-cache/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 3. Security Testing, Proxies & Scanner Artifacts (Burp, ZAP, Wireshark)
# ------------------------------------------------------------------------------
*.pcap
*.pcapng
*.cap
*.har
*.burp
*.zap
.burp/
.ZAP/
.ZAP_JVM/
zap.log
zap.yaml
burp-collaborator/

# Scan Outputs & Generated Penetration Test Reports
reports/
report.json
results.log
*.report.html
*.report.pdf
*.report.json
scan_results/
loot/
dumps/

# ------------------------------------------------------------------------------
# 4. Database, Session State & Ephemeral Logs
# ------------------------------------------------------------------------------
*.log
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
instance/
.webassets-cache
celerybeat-schedule
celerybeat.pid

# ------------------------------------------------------------------------------
# 5. Secrets, Keys & Credentials (Prevent Accidental Token Commits)
# ------------------------------------------------------------------------------
secrets/
keys/
*.pem
*.key
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
tokens.json
credentials.json
auth_tokens.txt

# ------------------------------------------------------------------------------
# 6. Docker & Container Local Overrides
# ------------------------------------------------------------------------------
docker-compose.override.yml
.docker/
*.tar.gz

# ------------------------------------------------------------------------------
# 7. Unit Tests, Coverage & Code Quality
# ------------------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 8. IDEs, Text Editors & Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable

# JetBrains (PyCharm, IntelliJ, etc.)
.idea/
*.iws
*.iml

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Cursor
.cursorignore
.cursorindexingignore

# Jupyter Notebooks & IPython
.ipynb_checkpoints
profile_default/
ipython_config.py
